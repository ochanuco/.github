{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "CI が通った更新を自動マージする。グループの PR は含まれる更新がすべて自動マージの対象のときだけマージされるので、人がレビューする更新は別のグループに分ける",
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "non-major は tooling も runtime も自動マージする",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "本番で動く依存の 0.x の minor は破壊的変更を含みうるので人がレビューする",
      "matchDepTypes": ["dependencies", "optionalDependencies", "project.dependencies", "require"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "groupName": "runtime (0.x minor)",
      "groupSlug": "runtime-0x-minor"
    },
    {
      "description": "GitHub Actions とツールの major は CI が通れば壊れにくいので自動マージする",
      "matchManagers": ["github-actions", "mise"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "groupName": "tooling (major, automerge)",
      "groupSlug": "tooling-major-automerge"
    },
    {
      "matchPackageNames": ["@types/**"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "groupName": "tooling (major, automerge)",
      "groupSlug": "tooling-major-automerge"
    }
  ]
}
